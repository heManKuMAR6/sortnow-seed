{
  "name": "@sortnow/seed",
  "version": "0.1.0-alpha.1",
  "description": "Scheduled Experiences & Extensible Design for developers and agents",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heManKuMAR6/sortnow-seed.git"
  },
  "exports": {
    ".": "./dist/core/index.js",
    "./react": "./dist/react/index.js"
  },
  "types": "./dist/core/index.d.ts",
  "bin": {
    "seed": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm test && npm pack --dry-run",
    "demo": "npm run build && node scripts/demo.mjs",
    "demo:second": "npm run build && node scripts/demo-second-app.mjs",
    "test:browser": "npm run build && playwright test"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
